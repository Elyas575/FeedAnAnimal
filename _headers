/*
  Cloudflare Pages / Netlify header rules.
  Long cache for immutable-ish assets, no-cache for HTML so deploys land instantly.
*/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=()

/index.html
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

/activity.html
  Cache-Control: no-cache, must-revalidate

/auth.html
  Cache-Control: no-cache, must-revalidate

/index.js
  # The popup markup (including the Directions button) is built here, while
  # index.html revalidates. Caching this for an hour lets a browser pair NEW
  # markup with an OLD stylesheet, which is how the Directions label ended up
  # unreadable. Must revalidate like the pages that reference it.
  Cache-Control: no-cache, must-revalidate

/supabase-client.js
  Cache-Control: public, max-age=3600, must-revalidate

/site-header.js
  Cache-Control: no-cache, must-revalidate

/tailwind-theme.js
  Cache-Control: public, max-age=3600, must-revalidate

/community.js
  Cache-Control: public, max-age=3600, must-revalidate

/forum.js
  Cache-Control: public, max-age=3600, must-revalidate

/data/*
  Cache-Control: public, max-age=3600, must-revalidate

/og-image.svg
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff